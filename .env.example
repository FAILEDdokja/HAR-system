# Copy to .env and edit; every value has a working default, so an empty .env
# still brings the stack up.  .env is in .gitignore and .dockerignore.

# --- image build -----------------------------------------------------------
# cpu  = default; ~2 GB image, runs anywhere.  cuda = GPU box (see compose.gpu.yml).
TORCH_CHANNEL=cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# CUDA channel only (compose.gpu.yml overrides it to cu130, matching the lock):
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

# --- runtime ---------------------------------------------------------------
# Host port that serves the monitoring GUI and the MJPEG stream.
HAR_HOST_PORT=8080

# Where run artefacts (events.jsonl, events.csv, meta.json, recordings/) go:
# the default names a Docker *volume* (`har-runs`, declared in
# docker-compose.yml), which Docker manages and owns — no host path to chown,
# and no bind-mount permission failure on Windows Docker Desktop.  To keep the
# artefacts as plain files on the host instead, set HAR_DATA_DIR to a path
# beginning with ./ or / (e.g. ./runs); anything without a leading ./ or / is
# treated as a volume name by Docker.  Run artefacts land in
# ${HAR_DATA_DIR}/${HAR_RUN_NAME}.
# Windows Docker Desktop note: a named volume is the safe default, and a
# bind mount of a Windows path works only if it is shared with the WSL2 VM
# (Settings → Resources → File sharing) and the directory is created from
# Windows first.  Bind mounts are also much slower than named volumes there.
HAR_DATA_DIR=har-runs
HAR_RUN_NAME=latest

# Container uid:gid.  The defaults (1001) match the image's `har` user and the
# ownership of a fresh named volume, so leave them alone unless you switch to
# a bind mount — then set them to the ids that own HAR_DATA_DIR on the host
# (id -u / id -g) or the mount will be read-only.
HAR_UID=1001
HAR_GID=1001

# Extra `python -m har.app` flags, word-split, e.g. "--imgsz 320 --conf 0.6".
HAR_EXTRA_ARGS=

# GPU only.
# NVIDIA_VISIBLE_DEVICES=all
